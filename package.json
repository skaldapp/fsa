{
  "$schema": "https://www.schemastore.org/package",
  "name": "@skaldapp/fsa",
  "version": "1.1.20",
  "description": "A TypeScript library providing a File System Access API wrapper for web applications. Offers AWS S3-like operations (get, put, delete, head) to interact with local file systems efficiently in modern browsers.",
  "keywords": [
    "file-system-access",
    "web-api",
    "file-handling",
    "fsa-api",
    "browser-filesystem",
    "file-operations",
    "s3-like-api",
    "typescript",
    "web-storage",
    "local-file-system",
    "file-upload",
    "file-download",
    "directory-handle",
    "file-handle",
    "web-platform"
  ],
  "homepage": "https://github.com/skaldapp/fsa#readme",
  "bugs": {
    "url": "https://github.com/skaldapp/fsa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skaldapp/fsa.git"
  },
  "license": "AGPL-3.0-only",
  "author": "Jerry Bruwes <jbruwes@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint ."
  },
  "prettier": "@skaldapp/configs/prettierrc",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@skaldapp/configs": "^1.4.8",
    "@smithy/types": "^4.16.1",
    "eslint": "^10.7.0"
  }
}
